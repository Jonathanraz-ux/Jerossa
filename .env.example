# JEROSSA — Supabase
# Copiez ce fichier vers .env puis renseignez vos valeurs.
# Les variables VITE_* sont exposées au navigateur : n'y mettez JAMAIS de secret (service_role).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Utilisé UNIQUEMENT par la CLI Supabase en local (jamais importé dans le navigateur).
# À recréer en variable d'environnement censée dans le CI/CD. Laisser vide.
SUPABASE_ACCESS_TOKEN=
